<?xml version="1.0" encoding="utf-8"?>
<!-- The application and activity entries are generated from the [Application] and [Activity]
     attributes and merged into this file at build time. No permission is requested: the lists live in
     the application's private storage, and import and export go through the system file picker,
     which grants access to the one file the user picks (a Debug build adds INTERNET by itself, for
     the debugger). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <application android:label="Lists" android:icon="@drawable/icon" />
</manifest>
