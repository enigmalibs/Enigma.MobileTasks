<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Single-TFM on purpose: this library is app-internal (it ships only inside the Android
         application) and is never published to NuGet. Plain net10.0 rather than net10.0-android:
         the model has nothing platform-specific, and it builds and tests on any machine without the
         Android workload. -->
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Enigma.MobileTasks.Core</RootNamespace>
  </PropertyGroup>
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent:
       they come from Directory.Build.props. -->
</Project>
