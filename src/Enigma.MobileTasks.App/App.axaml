<!--
  Default — follow the phone — until the saved preference is applied, which happens before the first
  view is built (App.ApplyTheme). The Enigma palette defines a Light and a Dark dictionary; where a
  platform cannot resolve Default to one of them, ApplyTheme requests the platform's variant itself.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Enigma.MobileTasks.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Enigma.MobileTasks.App/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The Enigma palette is a ResourceDictionary, so it is a ResourceInclude here and never a
             StyleInclude. -->
        <ResourceInclude Source="avares://Enigma.MobileTasks.App/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
