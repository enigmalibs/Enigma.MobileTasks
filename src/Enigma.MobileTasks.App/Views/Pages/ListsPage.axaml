<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:res="using:Enigma.MobileTasks.App.Resources"
             xmlns:vm="using:Enigma.MobileTasks.App.ViewModels.Pages"
             x:Class="Enigma.MobileTasks.App.Views.Pages.ListsPage"
             x:DataType="vm:ListsPageViewModel"
             Header="{x:Static res:Strings.ListsHeader}"
             Background="{DynamicResource EnigmaBackgroundBrush}"
             Foreground="{DynamicResource EnigmaForegroundBrush}">

  <!-- The page's actions sit in the navigation bar, at the thumb-reachable end of the title. -->
  <NavigationPage.TopCommandBar>
    <StackPanel x:Name="CommandBar" Orientation="Horizontal" Margin="0,0,4,0">
      <Button x:Name="NewListButton"
              Classes="icon"
              Command="{Binding NewListCommand}"
              AutomationProperties.Name="{x:Static res:Strings.NewList}"
              ToolTip.Tip="{x:Static res:Strings.NewList}">
        <ei:Icon Kind="Plus" Size="{StaticResource IconSizeMedium}" />
      </Button>
    </StackPanel>
  </NavigationPage.TopCommandBar>

  <Grid>
    <ScrollViewer IsVisible="{Binding !IsEmpty}">
      <ItemsControl ItemsSource="{Binding Cards}" Margin="16,12,16,96">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ListCardViewModel">
            <!-- The whole card opens the list; the corner button carries everything else. -->
            <Border Classes="card" Padding="0" Margin="0,0,0,12">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="cardbody" Command="{Binding OpenCommand}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="title" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Classes="caption"
                                 Text="{Binding ProgressText}"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0" />
                    </Grid>
                    <ProgressBar Classes="listprogress"
                                 Classes.complete="{Binding IsComplete}"
                                 Value="{Binding Percent}"
                                 Maximum="100" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Classes="icon"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="{Binding ActionsLabel}">
                  <ei:Icon Kind="DotsThreeVertical" Size="{StaticResource IconSizeMedium}" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{x:Static res:Strings.Rename}" Command="{Binding RenameCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="PencilSimple" Size="{StaticResource IconSizeSmall}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{x:Static res:Strings.Duplicate}" Command="{Binding DuplicateCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="Copy" Size="{StaticResource IconSizeSmall}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="{x:Static res:Strings.Delete}" Command="{Binding DeleteCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="Trash" Size="{StaticResource IconSizeSmall}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Classes="emptystate" IsVisible="{Binding IsEmpty}">
      <ei:Icon Kind="ListChecks"
               Size="{StaticResource IconSizeEmptyState}"
               Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}"
               HorizontalAlignment="Center" />
      <TextBlock Classes="title" Text="{x:Static res:Strings.NoListsTitle}" />
      <TextBlock Classes="caption" Text="{x:Static res:Strings.NoListsHint}" />
      <Button Classes="accent"
              HorizontalAlignment="Center"
              Margin="0,12,0,0"
              Command="{Binding NewListCommand}"
              Content="{x:Static res:Strings.NewList}" />
    </StackPanel>
  </Grid>

</ContentPage>
