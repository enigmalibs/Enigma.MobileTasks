<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The application's theme entry point: the Enigma palette and its brushes, merged in the order
       the desktop library merges them — Colors.axaml first, because every brush resolves its colour
       from the layer above it. A ResourceDictionary, so App.axaml merges it with a ResourceInclude,
       never a StyleInclude. -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Enigma.MobileTasks.App/Themes/Colors.axaml" />
    <ResourceInclude Source="avares://Enigma.MobileTasks.App/Themes/Brushes.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- FluentTheme's own CheckBox keys, re-coloured the way the desktop library re-colours TextBox
       and ComboBox: left alone, a ticked row is painted with the phone's system accent instead of
       the Enigma one. The key names are Fluent's contract and must stay verbatim. Kept here, not in
       the vendored Brushes.axaml, which stays byte-identical to the desktop release. -->
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource EnigmaAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />

  <!-- The same for the theme choice's radio buttons. -->
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource EnigmaAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource EnigmaAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource EnigmaAccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource EnigmaAccentHoverColor}" />

</ResourceDictionary>
