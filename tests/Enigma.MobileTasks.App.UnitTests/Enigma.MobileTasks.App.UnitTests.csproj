<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single TFM of the project under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Enigma.MobileTasks.App.UnitTests</RootNamespace>
    <!-- Headless render tests build views; the compiled-binding switch matches the app under test. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- Test-only: the published palette the vendored Themes/*.axaml are compared against. -->
    <PackageReference Include="Enigma.Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.MobileTasks.App/Enigma.MobileTasks.App.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: the reference list the suite loads by relative path next to the test
       assembly. -->
  <ItemGroup>
    <None Update="**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
